.mypy_cache/
.pyrightcache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.codegraph/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ===== Packaging/Build =====
build/
dist/
*.egg-info/
pip-wheel-metadata/

# ===== PyInstaller extras =====
# (hwp_converter.spec 은 추적 — *.spec 를 통째로 ignore 하지 않음)
# 보안 모듈 DLL 은 hwpmate/resources/security/ 에 커밋 (배포 번들 필수)
*.manifest
*.pkg
*.toc

# ===== Local agent / tool caches (레포 루트) =====
.agents/
.grok/
# Spec Kit 로컬 산출은 팀 정책에 따라 추적 가능 — 기본은 무시하지 않음
# .specify/ 와 specs/ 는 기능 명세 작업 시 커밋할 수 있음

